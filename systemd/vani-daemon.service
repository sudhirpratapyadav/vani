[Unit]
Description=vani dictation daemon
# X11 tools (xinput, xdotool) need a live graphical session, so the daemon is
# tied to it: started after it, and stopped with it.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/vani start
Restart=on-failure
RestartSec=5
# DISPLAY/XAUTHORITY normally arrive via the session's
# `systemctl --user import-environment`; this is the fallback.
Environment=DISPLAY=:0
# Logging goes to the journal (`journalctl --user -u vani-daemon -f`). Not to a
# file: systemd opens StandardOutput= before it runs anything in the unit, so
# `append:%h/.cache/vani/daemon.log` fails with 209/STDOUT on a fresh install
# where that directory does not exist yet — and an ExecStartPre=mkdir cannot
# fix it, because it is subject to the same redirection.

[Install]
WantedBy=default.target
